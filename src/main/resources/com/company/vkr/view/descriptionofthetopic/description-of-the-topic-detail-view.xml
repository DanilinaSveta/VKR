<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://descriptionOfTheTopicDetailView.title"
      focusComponent="form">
    <data>
        <instance id="descriptionOfTheTopicDc"
                  class="com.company.vkr.entity.DescriptionOfTheTopic">
            <fetchPlan extends="_base"/>
            <loader id="descriptionOfTheTopicDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="descriptionOfTheTopicDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="shortDescriptionField" property="shortDescription"/>
            <textArea id="descriptionField" property="description" minWidth="100%" height="150px"/>
            <textArea id="literatureRecommendationsField" property="literatureRecommendations" minWidth="100%"
                      height="150px"/>
            <textArea id="recommendedSkillsField" property="recommendedSkills" minWidth="100%" height="150px"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
